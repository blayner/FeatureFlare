{
  "name": "@featureflare/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for FeatureFlare feature flags and experiments, with local evaluation and real-time streaming.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "feature-flags",
    "feature-toggles",
    "ab-testing",
    "experiments",
    "sse"
  ]
}
